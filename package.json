{
  "name": "tiktop-shop",
  "version": "0.1.0",
  "private": true,
  "description": "AIGC e-commerce video generation system for TikTok Shop challenge",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter=!@tiktop/shared run dev",
    "dev:web": "pnpm --filter @tiktop/web dev",
    "dev:api": "pnpm --filter @tiktop/api dev",
    "dev:agent": "cd apps/agent && conda run --no-capture-output -n tiktop_agent_p1 python -m uvicorn agent_app.main:app --app-dir src --host 127.0.0.1 --port 8790",
    "build": "pnpm -r run build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"apps/web/src/**/*.{css,less}\" --allow-empty-input",
    "typecheck": "pnpm -r run typecheck",
    "test:agent": "cd apps/agent && conda run --no-capture-output -n tiktop_agent_p1 python -m pytest",
    "lint:agent": "cd apps/agent && conda run --no-capture-output -n tiktop_agent_p1 python -m ruff check .",
    "prepare": "husky",
    "check:ffmpeg": "node scripts/check-ffmpeg.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "stylelint": "^16.13.2",
    "stylelint-config-standard": "^37.0.0",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,less}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
