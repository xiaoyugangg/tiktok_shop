generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Material {
  id                  String   @id @default(cuid())
  kind                String
  filename            String
  path                String
  mime                String
  size                Int
  caption             String?
  summary             String?
  tagsJson            String?
  embeddingText       String?
  embeddingVectorJson String?
  embeddingModel      String?
  analyzedAt          DateTime?
  productId           String?
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt           DateTime @default(now())

  @@index([productId])
}

model Product {
  id              String       @id @default(cuid())
  title           String
  sellingPoints   String
  targetAudience  String?
  scene           String?
  mainMaterialId  String?
  materials       Material[]
  scripts         Script[]
  tasks           VideoTask[]
  createdAt       DateTime     @default(now())
}

model Script {
  id                  String                  @id @default(cuid())
  productId           String
  product             Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  referenceAnalysisId String?
  referenceAnalysis   ReferenceVideoAnalysis? @relation(fields: [referenceAnalysisId], references: [id], onDelete: SetNull)
  payload             String
  createdAt           DateTime                @default(now())
  tasks               VideoTask[]
  editingPlans        EditingPlan[]

  @@index([productId])
  @@index([referenceAnalysisId])
}

model ReferenceVideo {
  id           String                   @id @default(cuid())
  title        String
  sourceType   String
  sourceUrl    String?
  filename     String?
  path         String?
  mime         String?
  size         Int?
  category     String?
  keywordsJson String?
  analyses     ReferenceVideoAnalysis[]
  createdAt    DateTime                 @default(now())

  @@index([sourceType])
  @@index([category])
}

model ReferenceVideoAnalysis {
  id                   String         @id @default(cuid())
  referenceVideoId     String
  referenceVideo       ReferenceVideo @relation(fields: [referenceVideoId], references: [id], onDelete: Cascade)
  scripts              Script[]
  summary              String
  hookType             String
  painPoint            String
  sellingPointsJson    String
  shotStructureJson    String
  visualStyle          String
  subtitleStyle        String
  bgmRhythm            String
  ctaPattern           String
  reusableTemplate     String
  keyframeCaptionsJson String
  traceJson            String?
  createdAt            DateTime       @default(now())

  @@index([referenceVideoId])
}

model EditingPlan {
  id          String   @id @default(cuid())
  scriptId    String
  script      Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  strategy    String
  payloadJson String
  traceJson   String?
  videoTasks  VideoTask[]
  createdAt   DateTime @default(now())

  @@index([scriptId])
}

model VideoTask {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  scriptId      String
  script        Script       @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  editingPlanId String?
  editingPlan   EditingPlan? @relation(fields: [editingPlanId], references: [id], onDelete: SetNull)
  ratio         String
  status        String
  errorMsg      String?
  outputPath    String?
  shots         Shot[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([editingPlanId])
}

model Shot {
  id               String    @id @default(cuid())
  taskId           String
  task             VideoTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  idx              Int
  description      String
  cameraMotion     String
  durationSec      Float
  prompt           String?
  subtitle         String?
  bgmHint          String?
  sourceMaterialId String?
  retryCount       Int       @default(0)
  imagePath        String?
  clipPath         String?
  status           String
  errorMsg         String?

  @@index([taskId])
  @@unique([taskId, idx])
}

model TaskTrace {
  id          String   @id @default(cuid())
  taskId      String
  shotId      String?
  stage       String
  level       String
  message     String
  payloadJson String?
  createdAt   DateTime @default(now())

  @@index([taskId])
  @@index([shotId])
}

model MockMetric {
  id             String   @id @default(cuid())
  productId      String?
  taskId         String?
  factor         String
  ctr            Float
  cvr            Float
  completionRate Float
  createdAt      DateTime @default(now())

  @@index([productId])
  @@index([taskId])
}
